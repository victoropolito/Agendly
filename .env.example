# PostgreSQL
POSTGRES_DB=agendly
POSTGRES_USER=agendly
POSTGRES_PASSWORD=change-me-in-local-development
DATABASE_URL=postgresql://agendly:change-me-in-local-development@localhost:5432/agendly?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3001
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_CUSTOMER_ACCESS_SECRET=replace-with-a-long-random-secret-for-customers
JWT_CUSTOMER_REFRESH_SECRET=replace-with-a-different-long-random-secret-for-customers

# Evolution API (self-hosted WhatsApp via QR code, see docker-compose.yml)
EVOLUTION_API_KEY=replace-with-a-long-random-secret-for-the-evolution-api-server
EVOLUTION_API_URL=http://localhost:8080
