generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TenantRole {
  ADMIN
  PROFESSIONAL
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  PUBLIC
  ADMIN
  PROFESSIONAL
}

enum ScheduleEntryKind {
  APPOINTMENT
  BLOCK
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationType {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_REMINDER
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum WhatsAppProvider {
  META_CLOUD_API
  TWILIO
  EVOLUTION_API
  DEVELOPMENT
}

enum ConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  ERROR
}

model Tenant {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(120)
  slug                String               @unique @db.VarChar(100)
  timezone            String               @default("America/Sao_Paulo") @db.VarChar(64)
  phone               String?              @db.VarChar(32)
  email               String?              @db.VarChar(255)
  description         String?              @db.Text
  address             String?              @db.Text
  logoUrl             String?              @db.Text
  status              TenantStatus         @default(ACTIVE)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?            @db.Timestamptz(6)
  members             TenantMember[]
  professionals       Professional[]
  customers           Customer[]
  services            Service[]
  businessHours       BusinessHour[]
  appointments        Appointment[]
  scheduleBlocks      ScheduleBlock[]
  scheduleEntries     ScheduleEntry[]
  notifications       Notification[]
  whatsappConnections WhatsAppConnection[]
  authSessions        AuthSession[]

  @@index([status])
  @@map("tenants")
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  name            String         @db.VarChar(120)
  phoneNormalized String?        @unique @db.VarChar(20)
  email           String?        @unique @db.VarChar(255)
  passwordHash    String         @db.VarChar(255)
  status          UserStatus     @default(ACTIVE)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)
  tenantMembers   TenantMember[]
  professionals   Professional[]
  customers       Customer[]
  authSessions    AuthSession[]

  @@map("users")
}

model TenantMember {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @db.Uuid
  userId    String     @db.Uuid
  role      TenantRole
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, role])
  @@index([userId])
  @@map("tenant_members")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @db.VarChar(255)
  expiresAt        DateTime  @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Professional {
  id        String                @id @default(uuid()) @db.Uuid
  tenantId  String                @db.Uuid
  userId    String?               @db.Uuid
  name      String                @db.VarChar(120)
  phone     String?               @db.VarChar(32)
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt DateTime              @updatedAt @db.Timestamptz(6)
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  services  ProfessionalService[]
  hours     ProfessionalHour[]
  appointments Appointment[]
  blocks    ScheduleBlock[]
  entries   ScheduleEntry[]

  @@unique([tenantId, userId])
  @@index([tenantId, isActive])
  @@map("professionals")
}

model Customer {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  userId          String?         @db.Uuid
  name            String          @db.VarChar(120)
  phoneNormalized String?         @db.VarChar(20)
  email           String?         @db.VarChar(255)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments    Appointment[]

  @@unique([tenantId, phoneNormalized])
  @@unique([tenantId, email])
  @@index([tenantId, name])
  @@map("customers")
}

model Service {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  name            String                @db.VarChar(120)
  description     String?               @db.Text
  priceCents      Int
  durationMinutes Int
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?             @db.Timestamptz(6)
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professionals   ProfessionalService[]
  appointments    Appointment[]

  @@index([tenantId, isActive])
  @@map("services")
}

model ProfessionalService {
  tenantId       String       @db.Uuid
  professionalId String       @db.Uuid
  serviceId      String       @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([tenantId, serviceId])
  @@map("professional_services")
}

model BusinessHour {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  weekday   Int
  startTime DateTime @db.Time(0)
  endTime   DateTime @db.Time(0)
  isActive  Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, weekday])
  @@map("business_hours")
}

model ProfessionalHour {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  professionalId String       @db.Uuid
  weekday        Int
  startTime      DateTime     @db.Time(0)
  endTime        DateTime     @db.Time(0)
  isActive       Boolean      @default(true)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, professionalId, weekday])
  @@map("professional_hours")
}

model Appointment {
  id                     String            @id @default(uuid()) @db.Uuid
  tenantId               String            @db.Uuid
  customerId             String            @db.Uuid
  professionalId         String            @db.Uuid
  serviceId              String            @db.Uuid
  startsAt               DateTime          @db.Timestamptz(6)
  endsAt                 DateTime          @db.Timestamptz(6)
  priceCentsSnapshot     Int
  durationMinutesSnapshot Int
  status                 AppointmentStatus @default(CONFIRMED)
  source                 AppointmentSource @default(PUBLIC)
  notes                  String?           @db.Text
  cancelledAt            DateTime?         @db.Timestamptz(6)
  reminderSentAt         DateTime?         @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(6)
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer               Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  professional           Professional      @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service                Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  scheduleEntry          ScheduleEntry?
  notifications          Notification[]

  @@index([tenantId, startsAt])
  @@index([professionalId, startsAt])
  @@index([status, reminderSentAt, startsAt])
  @@map("appointments")
}

model ScheduleBlock {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  professionalId String        @db.Uuid
  startsAt       DateTime      @db.Timestamptz(6)
  endsAt         DateTime      @db.Timestamptz(6)
  reason         String?       @db.VarChar(255)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  scheduleEntry  ScheduleEntry?

  @@index([professionalId, startsAt])
  @@map("schedule_blocks")
}

model ScheduleEntry {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  professionalId  String            @db.Uuid
  appointmentId   String?           @unique @db.Uuid
  scheduleBlockId String?           @unique @db.Uuid
  kind            ScheduleEntryKind
  startsAt        DateTime          @db.Timestamptz(6)
  endsAt          DateTime          @db.Timestamptz(6)
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  professional    Professional      @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  appointment     Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  scheduleBlock   ScheduleBlock?    @relation(fields: [scheduleBlockId], references: [id], onDelete: Cascade)

  @@index([tenantId, professionalId, startsAt])
  @@map("schedule_entries")
}

model Notification {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  appointmentId String?            @db.Uuid
  channel       NotificationChannel
  type          NotificationType
  recipient     String             @db.VarChar(255)
  payload       Json
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  lastError     String?            @db.Text
  sentAt        DateTime?          @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@map("notifications")
}

model WhatsAppConnection {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @db.Uuid
  provider             WhatsAppProvider
  status               ConnectionStatus  @default(DISCONNECTED)
  phoneNumberId        String?           @db.VarChar(255)
  businessAccountId    String?           @db.VarChar(255)
  credentialsReference String?           @db.Text
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("whatsapp_connections")
}
